# Local development uses the in-memory lobby repository by default.
LOBBY_STORE=memory
PORT=3000

# Production defaults to Cosmos DB for MongoDB. Never commit a real credential.
AZURE_COSMOS_CONNECTIONSTRING=mongodb://username:password@your-account.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb&retrywrites=false
COSMOS_DATABASE_ID=flip-seven
COSMOS_COLLECTION_ID=lobbies