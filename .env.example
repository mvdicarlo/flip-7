# Local development uses the in-memory lobby repository by default.
LOBBY_STORE=memory
PORT=3000

# Production defaults to Cosmos DB. The key is optional when the App Service
# managed identity has Cosmos DB data-plane access.
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DATABASE_ID=flip-seven
COSMOS_CONTAINER_ID=lobbies
COSMOS_AUTO_CREATE=false